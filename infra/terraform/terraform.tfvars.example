# Copy to terraform.tfvars (git-ignored). Secrets can instead be passed as
# TF_VAR_app_storage_access_key / TF_VAR_app_storage_secret_key environment variables.
domain = "dataflow.example.com"

# Defaults keep the setup small: 2 nodes (2 vCPU / 8 GB), single-instance PostgreSQL.
# node_count = 2
# db_ha      = false

app_storage_access_key = "CHANGE-ME"
app_storage_secret_key = "CHANGE-ME"
