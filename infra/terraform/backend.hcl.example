# Copy to backend.hcl (git-ignored), then: terraform init -backend-config=backend.hcl
# The state bucket is created once in the NCP console before the first init.
# Credentials: set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY to your NCP API keys.
bucket = "dataflow-tfstate-CHANGE-ME"
key    = "prod/terraform.tfstate"
region = "kr-standard"

endpoints = {
  s3 = "https://kr.object.ncloudstorage.com"
}

use_path_style              = true
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
